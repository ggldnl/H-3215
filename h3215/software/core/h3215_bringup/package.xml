<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h3215_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for H-3215: the control loop, the camera, the whole robot</description>
  <maintainer email="ggldnl@users.noreply.github.com">Daniel Gigliotti</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>h3215_core</exec_depend>
  <exec_depend>h3215_description</exec_depend>
  <exec_depend>h3215_hardware</exec_depend>
  <exec_depend>hardware_interface</exec_depend>  <!-- mock_components/GenericSystem -->
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
