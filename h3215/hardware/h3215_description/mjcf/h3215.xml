<!--
  Provisional H-3215 model, until the CAD exists.

  Leg proportions come from H-0996 (coxa 68 mm, femur 77 mm, tibia 122 mm, legs every 45 deg),
  shapes are primitives and masses are estimates: 55 g per STS3215 plus brackets, and a 1.03 kg
  base holding the six coxa servos, the Pi 5, the servo board, the battery and the camera.
  Total: 2.14 kg.

  Frame: x forward, y left, z up. Legs are numbered like H-0996, clockwise from above:
  1 front-right, 2 middle-right, 3 rear-right, 4 rear-left, 5 middle-left, 6 front-left.
  In each leg frame x points out of the body. Joint 1 (coxa) turns the leg around z, positive
  joint 2 (femur) lifts the femur, positive joint 3 (tibia) swings the foot outward.

  The code finds the robot's structure from these names (h3215/software/training/src/h3215_train/morphology.py):
    base                      the body with the free joint, holding site "imu"
    leg_<i>_link_<j>          body j of leg i, counted from the base (i, j from 1, no gaps)
    leg_<i>_joint_<j>         the hinge joint of body leg_<i>_link_<j>
    leg_<i>_foot              site at the foot tip, in the leg's last body
    leg_<i>_foot_collision    geom of the foot, the only one meant to touch the ground
    camera_link               site where the depth camera is mounted (optional)
    *_collision               geoms that collide in simulation
    keyframe "home"           the default pose: only the joint angles are used, the base
                              height is computed so that the feet touch the ground
    sensors imu_ang_vel, imu_lin_vel, imu_lin_acc, imu_upvector, root_angmom
                              read by the training tasks, as below
  Add a leg, or a joint to every leg, by following them: training and the ROS description
  adapt. Actuators and joint dynamics are added in training by
  h3215/software/training/src/h3215_train/robot.py.
-->
<mujoco model="h3215">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="h3215">
      <joint type="hinge" axis="0 -1 0"/>
      <geom group="2" contype="0" conaffinity="0" rgba="0.2 0.2 0.22 1"/>
      <site group="5"/>
      <default class="coxa">
        <joint axis="0 0 1" range="-0.785 0.785"/>
        <geom type="box" pos="0.045 0 -0.011" size="0.025 0.0175 0.018" mass="0.075"/>
      </default>
      <default class="femur">
        <joint range="-1.571 1.571"/>
        <geom type="capsule" fromto="0 0 0 0.077 0 0" size="0.012" mass="0.075"/>
      </default>
      <default class="tibia">
        <joint range="-1.571 1.571"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.105" size="0.008" mass="0.03"/>
      </default>
      <default class="foot">
        <geom type="sphere" pos="0 0 -0.112" size="0.01" mass="0.005" rgba="0.9 0.45 0.1 1"/>
        <site type="sphere" pos="0 0 -0.112" size="0.011"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0.13" childclass="h3215">
      <freejoint name="floating_base_joint"/>
      <geom name="base_collision" type="box" size="0.1 0.065 0.03" mass="1.03" rgba="0.75 0.75 0.78 1"/>
      <site name="imu" pos="0 0 0"/>
      <!-- The depth camera's mount, provisional: the RealSense driver's frames hang from it -->
      <site name="camera_link" pos="0.1 0 0.03"/>

      <body name="leg_1_link_1" pos="0.082 -0.057 0" euler="0 0 -0.7854">
        <joint name="leg_1_joint_1" class="coxa"/>
        <geom name="leg_1_link_1_collision" class="coxa"/>
        <body name="leg_1_link_2" pos="0.068 0 -0.022">
          <joint name="leg_1_joint_2" class="femur"/>
          <geom name="leg_1_link_2_collision" class="femur"/>
          <body name="leg_1_link_3" pos="0.077 0 0">
            <joint name="leg_1_joint_3" class="tibia"/>
            <geom name="leg_1_link_3_collision" class="tibia"/>
            <geom name="leg_1_foot_collision" class="foot"/>
            <site name="leg_1_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_2_link_1" pos="0 -0.071 0" euler="0 0 -1.5708">
        <joint name="leg_2_joint_1" class="coxa"/>
        <geom name="leg_2_link_1_collision" class="coxa"/>
        <body name="leg_2_link_2" pos="0.068 0 -0.022">
          <joint name="leg_2_joint_2" class="femur"/>
          <geom name="leg_2_link_2_collision" class="femur"/>
          <body name="leg_2_link_3" pos="0.077 0 0">
            <joint name="leg_2_joint_3" class="tibia"/>
            <geom name="leg_2_link_3_collision" class="tibia"/>
            <geom name="leg_2_foot_collision" class="foot"/>
            <site name="leg_2_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_3_link_1" pos="-0.082 -0.057 0" euler="0 0 -2.3562">
        <joint name="leg_3_joint_1" class="coxa"/>
        <geom name="leg_3_link_1_collision" class="coxa"/>
        <body name="leg_3_link_2" pos="0.068 0 -0.022">
          <joint name="leg_3_joint_2" class="femur"/>
          <geom name="leg_3_link_2_collision" class="femur"/>
          <body name="leg_3_link_3" pos="0.077 0 0">
            <joint name="leg_3_joint_3" class="tibia"/>
            <geom name="leg_3_link_3_collision" class="tibia"/>
            <geom name="leg_3_foot_collision" class="foot"/>
            <site name="leg_3_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_4_link_1" pos="-0.082 0.057 0" euler="0 0 2.3562">
        <joint name="leg_4_joint_1" class="coxa"/>
        <geom name="leg_4_link_1_collision" class="coxa"/>
        <body name="leg_4_link_2" pos="0.068 0 -0.022">
          <joint name="leg_4_joint_2" class="femur"/>
          <geom name="leg_4_link_2_collision" class="femur"/>
          <body name="leg_4_link_3" pos="0.077 0 0">
            <joint name="leg_4_joint_3" class="tibia"/>
            <geom name="leg_4_link_3_collision" class="tibia"/>
            <geom name="leg_4_foot_collision" class="foot"/>
            <site name="leg_4_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_5_link_1" pos="0 0.071 0" euler="0 0 1.5708">
        <joint name="leg_5_joint_1" class="coxa"/>
        <geom name="leg_5_link_1_collision" class="coxa"/>
        <body name="leg_5_link_2" pos="0.068 0 -0.022">
          <joint name="leg_5_joint_2" class="femur"/>
          <geom name="leg_5_link_2_collision" class="femur"/>
          <body name="leg_5_link_3" pos="0.077 0 0">
            <joint name="leg_5_joint_3" class="tibia"/>
            <geom name="leg_5_link_3_collision" class="tibia"/>
            <geom name="leg_5_foot_collision" class="foot"/>
            <site name="leg_5_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_6_link_1" pos="0.082 0.057 0" euler="0 0 0.7854">
        <joint name="leg_6_joint_1" class="coxa"/>
        <geom name="leg_6_link_1_collision" class="coxa"/>
        <body name="leg_6_link_2" pos="0.068 0 -0.022">
          <joint name="leg_6_joint_2" class="femur"/>
          <geom name="leg_6_link_2_collision" class="femur"/>
          <body name="leg_6_link_3" pos="0.077 0 0">
            <joint name="leg_6_joint_3" class="tibia"/>
            <geom name="leg_6_link_3_collision" class="tibia"/>
            <geom name="leg_6_foot_collision" class="foot"/>
            <site name="leg_6_foot" class="foot"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro name="imu_ang_vel" site="imu"/>
    <velocimeter name="imu_lin_vel" site="imu"/>
    <accelerometer name="imu_lin_acc" site="imu"/>
    <framezaxis name="imu_upvector" objtype="body" objname="world" reftype="site" refname="imu"/>
    <subtreeangmom name="root_angmom" body="base"/>
  </sensor>

  <keyframe>
    <!-- Base pose (ignored, see above), then the joints in the order they appear above -->
    <key name="home" qpos="0 0 0.13 1 0 0 0  0 0.35 -0.25 0 0.35 -0.25 0 0.35 -0.25 0 0.35 -0.25 0 0.35 -0.25 0 0.35 -0.25"/>
  </keyframe>
</mujoco>
