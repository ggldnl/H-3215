  <ros2_control name="h3215" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>h3215_hardware/StsSystem</plugin>
        <param name="port">$(arg port)</param>
        <param name="baudrate">1000000</param>
        <param name="stall_torque">2.94</param>
      </xacro:unless>
    </hardware>
    <joint name="leg_1_joint_1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage">
        <param name="initial_value">11.4</param>
      </state_interface>
      <state_interface name="temperature">
        <param name="initial_value">30.0</param>
      </state_interface>
      <state_interface name="status"/>
      <param name="id">1</param>
      <xacro:calibration_params joint="leg_1_joint_1"/>
    </joint>
    <joint name="leg_1_joint_2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.35</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage">
        <param name="initial_value">11.4</param>
      </state_interface>
      <state_interface name="temperature">
        <param name="initial_value">30.0</param>
      </state_interface>
