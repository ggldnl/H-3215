<!--
  Provisional H-3215 model, until the CAD exists.

  Leg proportions come from H-0996 (coxa 68 mm, femur 77 mm, tibia 122 mm, legs every 45 deg),
  shapes are primitives and masses are estimates: 55 g per STS3215 plus brackets, and a 1.03 kg
  base holding the six coxa servos, the Pi 5, the servo board, a 3S battery and the camera.
  Total: 2.14 kg.

  Frame: x forward, y left, z up. Legs are numbered like H-0996, clockwise from above:
  1 front-right, 2 middle-right, 3 rear-right, 4 rear-left, 5 middle-left, 6 front-left.
  In each leg frame x points out of the body. Positive femur lifts the femur, positive tibia
  swings the foot outward. Actuators and joint dynamics are added in training by
  hexapod/train/src/h3215_train/h3215/h3215_constants.py.

  The names of bodies, joints, geoms, sites and sensors are what the training tasks rely on
  (hexapod/train/src/h3215_train/env_cfgs.py): keep them when this file is replaced by the
  CAD export.
-->
<mujoco model="h3215">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="h3215">
      <joint type="hinge" axis="0 -1 0"/>
      <geom group="2" contype="0" conaffinity="0" rgba="0.2 0.2 0.22 1"/>
      <site group="5"/>
      <default class="coxa">
        <joint axis="0 0 1" range="-0.785 0.785"/>
        <geom type="box" pos="0.045 0 -0.011" size="0.025 0.0175 0.018" mass="0.075"/>
      </default>
      <default class="femur">
        <joint range="-1.571 1.571"/>
        <geom type="capsule" fromto="0 0 0 0.077 0 0" size="0.012" mass="0.075"/>
      </default>
      <default class="tibia">
        <joint range="-1.571 1.571"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.105" size="0.008" mass="0.03"/>
      </default>
      <default class="foot">
        <geom type="sphere" pos="0 0 -0.112" size="0.01" mass="0.005" rgba="0.9 0.45 0.1 1"/>
        <site type="sphere" pos="0 0 -0.112" size="0.011"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0.13" childclass="h3215">
      <freejoint name="floating_base_joint"/>
      <geom name="base_collision" type="box" size="0.1 0.065 0.03" mass="1.03" rgba="0.75 0.75 0.78 1"/>
      <site name="imu" pos="0 0 0"/>

      <body name="leg_1_coxa" pos="0.082 -0.057 0" euler="0 0 -0.7854">
        <joint name="leg_1_coxa_joint" class="coxa"/>
        <geom name="leg_1_coxa_collision" class="coxa"/>
        <body name="leg_1_femur" pos="0.068 0 -0.022">
          <joint name="leg_1_femur_joint" class="femur"/>
          <geom name="leg_1_femur_collision" class="femur"/>
          <body name="leg_1_tibia" pos="0.077 0 0">
            <joint name="leg_1_tibia_joint" class="tibia"/>
            <geom name="leg_1_tibia_collision" class="tibia"/>
            <geom name="leg_1_foot_collision" class="foot"/>
            <site name="leg_1_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_2_coxa" pos="0 -0.071 0" euler="0 0 -1.5708">
        <joint name="leg_2_coxa_joint" class="coxa"/>
        <geom name="leg_2_coxa_collision" class="coxa"/>
        <body name="leg_2_femur" pos="0.068 0 -0.022">
          <joint name="leg_2_femur_joint" class="femur"/>
          <geom name="leg_2_femur_collision" class="femur"/>
          <body name="leg_2_tibia" pos="0.077 0 0">
            <joint name="leg_2_tibia_joint" class="tibia"/>
            <geom name="leg_2_tibia_collision" class="tibia"/>
            <geom name="leg_2_foot_collision" class="foot"/>
            <site name="leg_2_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_3_coxa" pos="-0.082 -0.057 0" euler="0 0 -2.3562">
        <joint name="leg_3_coxa_joint" class="coxa"/>
        <geom name="leg_3_coxa_collision" class="coxa"/>
        <body name="leg_3_femur" pos="0.068 0 -0.022">
          <joint name="leg_3_femur_joint" class="femur"/>
          <geom name="leg_3_femur_collision" class="femur"/>
          <body name="leg_3_tibia" pos="0.077 0 0">
            <joint name="leg_3_tibia_joint" class="tibia"/>
            <geom name="leg_3_tibia_collision" class="tibia"/>
            <geom name="leg_3_foot_collision" class="foot"/>
            <site name="leg_3_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_4_coxa" pos="-0.082 0.057 0" euler="0 0 2.3562">
        <joint name="leg_4_coxa_joint" class="coxa"/>
        <geom name="leg_4_coxa_collision" class="coxa"/>
        <body name="leg_4_femur" pos="0.068 0 -0.022">
          <joint name="leg_4_femur_joint" class="femur"/>
          <geom name="leg_4_femur_collision" class="femur"/>
          <body name="leg_4_tibia" pos="0.077 0 0">
            <joint name="leg_4_tibia_joint" class="tibia"/>
            <geom name="leg_4_tibia_collision" class="tibia"/>
            <geom name="leg_4_foot_collision" class="foot"/>
            <site name="leg_4_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_5_coxa" pos="0 0.071 0" euler="0 0 1.5708">
        <joint name="leg_5_coxa_joint" class="coxa"/>
        <geom name="leg_5_coxa_collision" class="coxa"/>
        <body name="leg_5_femur" pos="0.068 0 -0.022">
          <joint name="leg_5_femur_joint" class="femur"/>
          <geom name="leg_5_femur_collision" class="femur"/>
          <body name="leg_5_tibia" pos="0.077 0 0">
            <joint name="leg_5_tibia_joint" class="tibia"/>
            <geom name="leg_5_tibia_collision" class="tibia"/>
            <geom name="leg_5_foot_collision" class="foot"/>
            <site name="leg_5_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="leg_6_coxa" pos="0.082 0.057 0" euler="0 0 0.7854">
        <joint name="leg_6_coxa_joint" class="coxa"/>
        <geom name="leg_6_coxa_collision" class="coxa"/>
        <body name="leg_6_femur" pos="0.068 0 -0.022">
          <joint name="leg_6_femur_joint" class="femur"/>
          <geom name="leg_6_femur_collision" class="femur"/>
          <body name="leg_6_tibia" pos="0.077 0 0">
            <joint name="leg_6_tibia_joint" class="tibia"/>
            <geom name="leg_6_tibia_collision" class="tibia"/>
            <geom name="leg_6_foot_collision" class="foot"/>
            <site name="leg_6_foot" class="foot"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro name="imu_ang_vel" site="imu"/>
    <velocimeter name="imu_lin_vel" site="imu"/>
    <accelerometer name="imu_lin_acc" site="imu"/>
    <framezaxis name="imu_upvector" objtype="body" objname="world" reftype="site" refname="imu"/>
    <subtreeangmom name="root_angmom" body="base"/>
  </sensor>
</mujoco>
